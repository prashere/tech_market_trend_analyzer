# Copy this file to .env and fill in keys. Full walkthrough: setup.md
#
# Required for embeddings and cluster analysis: OPENAI_API_KEY
# Optional: PORT, CHAT_MODEL, EMBEDDING_MODEL, CLUSTER_COUNT, RSS_UPDATE_INTERVAL

OPENAI_API_KEY=

# Web server (Career Intelligence on the same machine already uses 8000)
PORT=8001

# Models — gpt-4o-mini is enough for a first run and is cheaper than gpt-4
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# How many topic groups to form (capped at the number of articles)
CLUSTER_COUNT=5

# Hours between scheduled RSS refreshes when you run: python main.py
RSS_UPDATE_INTERVAL=24
